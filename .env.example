# Admit — environment variables. Keep in sync with ARCHITECTURE.md §13.
# Never commit a filled-in .env.

# --- Network & contracts ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
ADMIT_CONTRACT=admit.<you>.testnet
TOKEN_CONTRACT=tusdc.<you>.testnet
SPUTNIK_FACTORY=sputnik-v2.testnet          # mainnet: sputnik-dao.near
COUNCIL_DAO=                               # Sputnik DAO v2 (e.g. herald-dao.sputnik-v2.testnet) or direct DAO deployer

# --- Accounts used by scripts (deploy/seed/demo) ---
DEPLOYER_ACCOUNT=
DEPLOYER_PRIVATE_KEY=
# Comma-separated; their keys live in ~/.near-credentials/testnet (near-cli legacy keychain)
COUNCIL_ACCOUNTS=
HOSPITAL_ACCOUNTS=
MEMBER_ACCOUNTS=

# --- Relayer (apps/api) ---
RELAYER_ACCOUNT=relay.<you>.testnet
RELAYER_PRIVATE_KEY=
API_PORT=8787
RELAY_RATE_LIMIT_PER_MIN=20

# --- Web (apps/web) — public, safe to expose ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_ADMIT_CONTRACT=admit.<you>.testnet
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- Optional (Could) ---
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
ONECLICK_API_KEY=
